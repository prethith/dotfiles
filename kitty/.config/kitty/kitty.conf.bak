# add theme
# include gruvbox_dark_hard.conf


# font settings
font_family         Lilex Nerd Font Mono
bold_font           auto
italic_font         auto
bold_italic_font    auto

font_size 17.0

# url style
url_style dashed

# mouse actions
select_by_word_characters @-./_~?&=%+#


# window settings
hide_window_decorations no


# background
background_opacity 1


# BEGIN_KITTY_THEME
# Kanagawa
include current-theme.conf
# END_KITTY_THEME